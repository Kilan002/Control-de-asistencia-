<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.NFC" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <uses-feature android:name="android.hardware.nfc" android:required="true" />

    <application
        android:name=".NFCheckApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/nfcheck"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/nfcheck_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Estilo1"
        tools:targetApi="31">

        <activity android:name=".LoginActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Paneles -->
        <activity android:name=".PanelAdminActivity"    android:exported="false" />
        <activity android:name=".PanelProfesorActivity" android:exported="false" />
        <activity android:name=".PanelAlumnoActivity"   android:exported="false" />

        <!-- Gestión -->
        <activity android:name=".GestionActivity"          android:exported="false" />
        <activity android:name=".CrearAlumnoActivity"      android:exported="false" android:launchMode="singleTop" />
        <activity android:name=".CrearProfesorActivity"    android:exported="false" />
        <activity android:name=".EditarAlumnoActivity"     android:exported="false" />
        <activity android:name=".EditarProfesorActivity"   android:exported="false" />
        <activity android:name=".ListaProfesoresActivity"  android:exported="false" />
        <activity android:name=".EditarMateriasProfesorActivity" android:exported="false" />

        <!-- Horarios -->
        <activity android:name=".HorarioProfesorActivity" android:exported="false" />
        <activity android:name=".VerHorarioActivity"      android:exported="false" />

        <!-- Asistencias -->
        <activity android:name=".NFCScannerActivity"         android:exported="false" android:launchMode="singleTop" />
        <activity android:name=".AsistenciaManualActivity"   android:exported="false" />
        <activity android:name=".VerAsistenciasActivity"     android:exported="false" />
        <activity android:name=".DetalleAsistenciasActivity" android:exported="false" />

        <!-- Otras -->
        <activity android:name=".SeleccionarMateriaActivity" android:exported="false" />
        <activity android:name=".DashboardProfesorActivity"  android:exported="false" />

    </application>

</manifest>