<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F6F9">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent" android:layout_height="wrap_content"
        app:cardCornerRadius="0dp" app:cardElevation="4dp" app:cardBackgroundColor="#1E40AF">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="20dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Asistencia Manual" android:textSize="22sp" android:textStyle="bold"
                android:textColor="#FFFFFF" android:layout_marginBottom="4dp"/>
            <TextView android:id="@+id/textContexto" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Selecciona los datos de la clase" android:textSize="13sp" android:textColor="#BFDBFE"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <ProgressBar android:id="@+id/progressManual" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal" android:layout_marginTop="12dp" android:visibility="gone"/>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="20dp">

            <!-- ─── Card Grupo ─── -->
            <androidx.cardview.widget.CardView android:id="@+id/cardGrupoManual"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="12dp" app:cardCornerRadius="16dp" app:cardElevation="2dp" app:cardBackgroundColor="#FFFFFF">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Grupo" android:textSize="13sp" android:textColor="#6B7280"
                        android:textAllCaps="true" android:letterSpacing="0.08" android:layout_marginBottom="8dp"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="4dp">
                        <TextView android:id="@+id/txtGrupoManualSeleccionado"
                            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:textSize="14sp" android:textStyle="bold" android:textColor="#2563EB"
                            android:background="@drawable/badge_justificante_bg"
                            android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="4dp" android:paddingBottom="4dp"
                            android:visibility="gone"/>
                        <Button android:id="@+id/btnLimpiarGrupoManual"
                            android:layout_width="wrap_content" android:layout_height="32dp"
                            android:text="✕" android:textSize="12sp" android:textColor="#DC2626"
                            android:backgroundTint="#FEE2E2" android:layout_marginStart="8dp"
                            android:visibility="gone" style="@style/Widget.MaterialComponents.Button.TextButton" app:cornerRadius="8dp"/>
                    </LinearLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:hint="Buscar grupo..." style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_marginBottom="4dp" app:startIconDrawable="@android:drawable/ic_menu_search"
                        app:boxCornerRadiusTopStart="10dp" app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp" app:boxCornerRadiusBottomEnd="10dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etBuscarGrupoManual" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:inputType="textCapCharacters"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <ListView android:id="@+id/listViewGruposManual"
                        android:layout_width="match_parent" android:layout_height="240dp"
                        android:background="#F8FAFF" android:divider="#E5E7EB" android:dividerHeight="1dp" android:visibility="gone"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ─── Card Materia ─── -->
            <androidx.cardview.widget.CardView android:id="@+id/cardMateriaManual"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="12dp" app:cardCornerRadius="16dp" app:cardElevation="2dp" app:cardBackgroundColor="#FFFFFF">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Materia" android:textSize="13sp" android:textColor="#6B7280"
                        android:textAllCaps="true" android:letterSpacing="0.08" android:layout_marginBottom="8dp"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="4dp">
                        <TextView android:id="@+id/txtMateriaManualSeleccionada"
                            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:textSize="14sp" android:textStyle="bold" android:textColor="#7C3AED"
                            android:background="@drawable/badge_justificante_bg"
                            android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="4dp" android:paddingBottom="4dp"
                            android:visibility="gone"/>
                        <Button android:id="@+id/btnLimpiarMateriaManual"
                            android:layout_width="wrap_content" android:layout_height="32dp"
                            android:text="✕" android:textSize="12sp" android:textColor="#DC2626"
                            android:backgroundTint="#FEE2E2" android:layout_marginStart="8dp"
                            android:visibility="gone" style="@style/Widget.MaterialComponents.Button.TextButton" app:cornerRadius="8dp"/>
                    </LinearLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:hint="Buscar materia..." style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_marginBottom="4dp" app:startIconDrawable="@android:drawable/ic_menu_search"
                        app:boxCornerRadiusTopStart="10dp" app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp" app:boxCornerRadiusBottomEnd="10dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etBuscarMateriaManual" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:inputType="textCapCharacters"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <ListView android:id="@+id/listViewMateriasManual"
                        android:layout_width="match_parent" android:layout_height="240dp"
                        android:background="#F8FAFF" android:divider="#E5E7EB" android:dividerHeight="1dp" android:visibility="gone"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ─── Card Alumno ─── -->
            <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="12dp" app:cardCornerRadius="16dp" app:cardElevation="2dp" app:cardBackgroundColor="#FFFFFF">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Alumno" android:textSize="13sp" android:textColor="#6B7280"
                        android:textAllCaps="true" android:letterSpacing="0.08" android:layout_marginBottom="8dp"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="4dp">
                        <TextView android:id="@+id/txtAlumnoManualSeleccionado"
                            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:textSize="14sp" android:textStyle="bold" android:textColor="#16A34A"
                            android:background="@drawable/badge_justificante_bg"
                            android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="4dp" android:paddingBottom="4dp"
                            android:visibility="gone"/>
                        <Button android:id="@+id/btnLimpiarAlumnoManual"
                            android:layout_width="wrap_content" android:layout_height="32dp"
                            android:text="✕" android:textSize="12sp" android:textColor="#DC2626"
                            android:backgroundTint="#FEE2E2" android:layout_marginStart="8dp"
                            android:visibility="gone" style="@style/Widget.MaterialComponents.Button.TextButton" app:cornerRadius="8dp"/>
                    </LinearLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:hint="Buscar alumno..." style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_marginBottom="4dp" app:startIconDrawable="@android:drawable/ic_menu_search"
                        app:boxCornerRadiusTopStart="10dp" app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp" app:boxCornerRadiusBottomEnd="10dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etBuscarAlumnoManual" android:layout_width="match_parent"
                            android:layout_height="wrap_content" android:inputType="textPersonName"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <ListView android:id="@+id/listViewAlumnosManual"
                        android:layout_width="match_parent" android:layout_height="240dp"
                        android:background="#F8FAFF" android:divider="#E5E7EB" android:dividerHeight="1dp" android:visibility="gone"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ─── Estado ─── -->
            <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginBottom="24dp" app:cardCornerRadius="16dp" app:cardElevation="2dp" app:cardBackgroundColor="#FFFFFF">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="20dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:text="Estado" android:textSize="13sp" android:textColor="#6B7280"
                        android:textAllCaps="true" android:letterSpacing="0.08" android:layout_marginBottom="12dp"/>
                    <RadioGroup android:id="@+id/radioEstado" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:orientation="vertical">
                        <RadioButton android:id="@+id/radioAsistencia" android:layout_width="match_parent"
                            android:layout_height="48dp" android:text="✔  Asistencia" android:checked="true"
                            android:textSize="15sp" android:textColor="#16A34A" android:buttonTint="#16A34A" android:gravity="center_vertical"/>
                        <RadioButton android:id="@+id/radioRetardo" android:layout_width="match_parent"
                            android:layout_height="48dp" android:text="⏰  Retardo"
                            android:textSize="15sp" android:textColor="#D97706" android:buttonTint="#D97706" android:gravity="center_vertical"/>
                        <RadioButton android:id="@+id/radioFalta" android:layout_width="match_parent"
                            android:layout_height="48dp" android:text="✖  Falta"
                            android:textSize="15sp" android:textColor="#DC2626" android:buttonTint="#DC2626" android:gravity="center_vertical"/>
                    </RadioGroup>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <Button android:id="@+id/btnRegistrarManual" android:layout_width="match_parent" android:layout_height="52dp"
        android:text="Registrar asistencia" android:textColor="#FFFFFF" android:textStyle="bold"
        android:backgroundTint="#2563EB" android:layout_margin="16dp" app:cornerRadius="14dp"/>

</LinearLayout>