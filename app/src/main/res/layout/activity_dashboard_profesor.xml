<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F6F9">

    <!-- Header azul — mismo estilo que CrearAlumno -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="0dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="#1E40AF">
        <ImageView
            android:layout_width="80dp"
            android:layout_height="70dp"
            android:layout_marginStart="300dp"
            android:layout_marginTop="5dp"
            android:src="@drawable/toro"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Dashboard"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="4dp"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Resumen de asistencias por grupo y materia"
                android:textSize="13sp"
                android:textColor="#BFDBFE"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Filtros: Grupo y Materia -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Filtros"
                        android:textSize="13sp"
                        android:textColor="#6B7280"
                        android:textAllCaps="true"
                        android:letterSpacing="0.08"
                        android:layout_marginBottom="16dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Grupo"
                        android:textSize="12sp"
                        android:textColor="#6B7280"
                        android:layout_marginBottom="4dp"/>

                    <Spinner
                        android:id="@+id/spinnerGrupoDash"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/spinner_bg"
                        android:layout_marginBottom="16dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Materia"
                        android:textSize="12sp"
                        android:textColor="#6B7280"
                        android:layout_marginBottom="4dp"/>

                    <Spinner
                        android:id="@+id/spinnerMateriaDash"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/spinner_bg"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Tarjetas de resumen -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Resumen general"
                        android:textSize="13sp"
                        android:textColor="#6B7280"
                        android:textAllCaps="true"
                        android:letterSpacing="0.08"
                        android:layout_marginBottom="16dp"/>

                    <!-- Fila 1: clases y alumnos -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <!-- Clases impartidas -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:background="@drawable/stat_card_bg_blue"
                            android:padding="14dp"
                            android:layout_marginEnd="8dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Clases"
                                android:textSize="11sp"
                                android:textColor="#1E40AF"
                                android:textAllCaps="true"
                                android:letterSpacing="0.06"/>
                            <TextView
                                android:id="@+id/txtDashTotalClases"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="—"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:textColor="#1E40AF"/>
                        </LinearLayout>

                        <!-- Total alumnos -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:background="@drawable/stat_card_bg_green"
                            android:padding="14dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Alumnos"
                                android:textSize="11sp"
                                android:textColor="#065F46"
                                android:textAllCaps="true"
                                android:letterSpacing="0.06"/>
                            <TextView
                                android:id="@+id/txtDashTotalAlumnos"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="—"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:textColor="#065F46"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Fila 2: promedio y en riesgo -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- Promedio -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:background="@drawable/stat_card_bg_purple"
                            android:padding="14dp"
                            android:layout_marginEnd="8dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Promedio"
                                android:textSize="11sp"
                                android:textColor="#5B21B6"
                                android:textAllCaps="true"
                                android:letterSpacing="0.06"/>
                            <TextView
                                android:id="@+id/txtDashPromedio"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="—"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:textColor="#5B21B6"/>
                        </LinearLayout>

                        <!-- En riesgo -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:background="@drawable/stat_card_red"
                            android:padding="14dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="En riesgo"
                                android:textSize="11sp"
                                android:textColor="#991B1B"
                                android:textAllCaps="true"
                                android:letterSpacing="0.06"/>
                            <TextView
                                android:id="@+id/txtDashRiesgo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="—"
                                android:textSize="20sp"
                                android:textStyle="bold"
                                android:textColor="#991B1B"/>
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Lista de alumnos -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Detalle por alumno"
                        android:textSize="13sp"
                        android:textColor="#6B7280"
                        android:textAllCaps="true"
                        android:letterSpacing="0.08"
                        android:layout_marginBottom="12dp"/>

                    <!-- Encabezado de tabla -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="36dp"
                        android:orientation="horizontal"
                        android:background="#EFF6FF"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="2.2"
                            android:text="Alumno"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="#1E40AF"
                            android:gravity="center_vertical"
                            android:textAllCaps="true"/>
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="0.7"
                            android:text="✅"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="#1E40AF"
                            android:gravity="center"/>
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="0.7"
                            android:text="⏰"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="#1E40AF"
                            android:gravity="center"/>
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="0.7"
                            android:text="❌"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="#1E40AF"
                            android:gravity="center"/>
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="0.9"
                            android:text="%"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:textColor="#1E40AF"
                            android:gravity="center"/>
                    </LinearLayout>

                    <!-- Filas de alumnos (se llenan dinámicamente) -->
                    <LinearLayout
                        android:id="@+id/layoutFilasAlumnos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"/>

                    <!-- Estado vacío -->
                    <TextView
                        android:id="@+id/txtDashVacio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Selecciona un grupo y materia"
                        android:textSize="14sp"
                        android:textColor="#9CA3AF"
                        android:gravity="center"
                        android:padding="24dp"
                        android:visibility="visible"/>

                    <ProgressBar
                        android:id="@+id/progressDash"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:visibility="gone"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

    <!-- Botón exportar — mismo estilo que btnGuardarAlumno -->
    <Button
        android:id="@+id/btnExportarExcel"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Exportar a Excel"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:backgroundTint="#2563EB"
        android:layout_margin="16dp"
        app:cornerRadius="14dp"/>

</LinearLayout>