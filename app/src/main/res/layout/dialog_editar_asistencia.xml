<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Estado de asistencia"
        android:textSize="13sp"
        android:textColor="#6B7280"
        android:textAllCaps="true"
        android:letterSpacing="0.08"
        android:layout_marginBottom="12dp"/>

    <RadioGroup
        android:id="@+id/radioGroupEstado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="16dp">

        <RadioButton
            android:id="@+id/radioAsistencia"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="✔  Asistencia"
            android:textSize="15sp"
            android:textColor="#16A34A"
            android:buttonTint="#16A34A"
            android:gravity="center_vertical"/>

        <RadioButton
            android:id="@+id/radioRetardo"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="⏰  Retardo"
            android:textSize="15sp"
            android:textColor="#D97706"
            android:buttonTint="#D97706"
            android:gravity="center_vertical"/>

        <RadioButton
            android:id="@+id/radioFalta"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="✖  Falta"
            android:textSize="15sp"
            android:textColor="#DC2626"
            android:buttonTint="#DC2626"
            android:gravity="center_vertical"/>
    </RadioGroup>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E5E7EB"
        android:layout_marginBottom="16dp"/>

    <CheckBox
        android:id="@+id/checkJustificante"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="📋  Tiene justificante"
        android:textSize="15sp"
        android:textColor="#1A1A2E"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp"/>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/layoutNota"
        android:hint="Motivo del justificante (opcional)"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        app:boxCornerRadiusTopStart="10dp"
        app:boxCornerRadiusTopEnd="10dp"
        app:boxCornerRadiusBottomStart="10dp"
        app:boxCornerRadiusBottomEnd="10dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edtNotaJustificante"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textMultiLine"
            android:maxLines="3"/>
    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>