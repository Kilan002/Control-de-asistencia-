<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F6F9">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="0dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="#1E40AF">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Gestión"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="4dp"/>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Busca y administra alumnos y profesores"
                android:textSize="13sp"
                android:textColor="#BFDBFE"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- ─── ALUMNOS ─── -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Alumnos"
                        android:textSize="13sp"
                        android:textColor="#6B7280"
                        android:textAllCaps="true"
                        android:letterSpacing="0.08"
                        android:layout_marginBottom="12dp"/>

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipAlumnoSeleccionado"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:visibility="gone"
                        android:layout_marginBottom="8dp"
                        app:chipBackgroundColor="#EFF6FF"
                        app:chipStrokeColor="#BFDBFE"
                        app:chipStrokeWidth="1dp"
                        app:closeIconVisible="true"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Buscar por nombre, matrícula o grupo..."
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_marginBottom="4dp"
                        app:startIconDrawable="@android:drawable/ic_menu_search"
                        app:boxCornerRadiusTopStart="10dp" app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp" app:boxCornerRadiusBottomEnd="10dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etBuscarAlumno"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPersonName"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <ListView
                        android:id="@+id/listViewAlumnos"
                        android:layout_width="match_parent"
                        android:layout_height="240dp"
                        android:background="#F8FAFF"
                        android:divider="#E5E7EB"
                        android:dividerHeight="1dp"
                        android:visibility="gone"
                        android:layout_marginBottom="12dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <Button
                            android:id="@+id/btnEditarAlumno"
                            android:layout_width="0dp" android:layout_height="44dp"
                            android:layout_weight="1"
                            android:text="✏ Editar" android:textSize="13sp"
                            android:textColor="#2563EB" android:backgroundTint="#EFF6FF"
                            android:layout_marginEnd="8dp" app:cornerRadius="10dp"/>
                        <Button
                            android:id="@+id/btnVerAsistenciasAlumno"
                            android:layout_width="0dp" android:layout_height="44dp"
                            android:layout_weight="1"
                            android:text="📋 Asistencias" android:textSize="12sp"
                            android:textColor="#FFFFFF" android:backgroundTint="#2563EB"
                            app:cornerRadius="10dp"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ─── PROFESORES ─── -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="#FFFFFF">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Profesores"
                        android:textSize="13sp"
                        android:textColor="#6B7280"
                        android:textAllCaps="true"
                        android:letterSpacing="0.08"
                        android:layout_marginBottom="12dp"/>

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipProfesorSeleccionado"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:visibility="gone"
                        android:layout_marginBottom="8dp"
                        app:chipBackgroundColor="#EFF6FF"
                        app:chipStrokeColor="#BFDBFE"
                        app:chipStrokeWidth="1dp"
                        app:closeIconVisible="true"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Buscar profesor por nombre..."
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_marginBottom="4dp"
                        app:startIconDrawable="@android:drawable/ic_menu_search"
                        app:boxCornerRadiusTopStart="10dp" app:boxCornerRadiusTopEnd="10dp"
                        app:boxCornerRadiusBottomStart="10dp" app:boxCornerRadiusBottomEnd="10dp">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etBuscarProfesor"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPersonName"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <ListView
                        android:id="@+id/listViewProfesores"
                        android:layout_width="match_parent"
                        android:layout_height="240dp"
                        android:background="#F8FAFF"
                        android:divider="#E5E7EB"
                        android:dividerHeight="1dp"
                        android:visibility="gone"
                        android:layout_marginBottom="12dp"/>

                    <!-- Fila 1: Editar + Horario -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">
                        <Button
                            android:id="@+id/btnEditarMateriasProfesor"
                            android:layout_width="0dp" android:layout_height="44dp"
                            android:layout_weight="1"
                            android:text="✏ Editar" android:textSize="13sp"
                            android:textColor="#2563EB" android:backgroundTint="#EFF6FF"
                            android:layout_marginEnd="8dp" app:cornerRadius="10dp"/>
                        <!--  Nuevo botón: ver/editar horario del profesor seleccionado -->
                        <Button
                            android:id="@+id/btnHorarioProfesor"
                            android:layout_width="0dp" android:layout_height="44dp"
                            android:layout_weight="1"
                            android:text="🗓 Horario" android:textSize="13sp"
                            android:textColor="#7C3AED" android:backgroundTint="#F5F3FF"
                            app:cornerRadius="10dp"/>
                    </LinearLayout>

                    <!-- Fila 2: Ver lista -->
                    <Button
                        android:id="@+id/btnListaProfesores"
                        android:layout_width="match_parent" android:layout_height="44dp"
                        android:text="👥 Ver lista completa de profesores" android:textSize="13sp"
                        android:textColor="#FFFFFF" android:backgroundTint="#7C3AED"
                        app:cornerRadius="10dp"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

</LinearLayout>