<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4F6F9">

    <!-- Header con nombre y cerrar sesión -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="0dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="#2563EB">
        <ImageView
            android:layout_width="80dp"
            android:layout_height="70dp"
            android:layout_marginStart="300dp"
            android:layout_marginTop="5dp"
            android:src="@drawable/toro" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/txtBienvenidaAlumno"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bienvenido"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/txtPorcentajeAlumno"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Asistencia: --%"
                android:textSize="13sp"
                android:textColor="#BFDBFE"/>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Selector de materia -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Materia"
            android:textSize="12sp"
            android:textColor="#6B7280"
            android:layout_marginBottom="4dp"/>

        <Spinner
            android:id="@+id/spinnerMateriaAlumno"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/spinner_bg_outlined"
            android:paddingStart="12dp"/>
    </LinearLayout>

    <!-- Lista de asistencias -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerAsistenciasAlumno"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:clipToPadding="false"/>

    <!-- Botón cerrar sesión -->
    <Button
        android:id="@+id/btnCerrarSesion"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="Cerrar sesión"
        android:textColor="#DC2626"
        android:backgroundTint="#FEE2E2"
        android:layout_margin="16dp"
        app:cornerRadius="12dp"/>

</LinearLayout>